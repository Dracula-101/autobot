# Browser (public by design — protected by row-level security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BASE=/autobot/

# Run the whole app on this device only, no account (dev / demos): add ?demo for sample data
# VITE_FORCE_LOCAL=1

# Server-side only (GitHub Actions secrets) — never ship these to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# External data sources (server-side only, set as Supabase function secrets): employee contacts +
# upcoming assignments. Use each project's secret key (Settings → API) — with RLS on, a publishable
# key usually can't see any rows.
CONTACTS_SUPABASE_URL=
CONTACTS_SERVICE_KEY=
ASSIGNMENTS_SUPABASE_URL=
ASSIGNMENTS_SERVICE_KEY=
